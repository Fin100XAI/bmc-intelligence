{
  "name": "bmc-intelligence-infrastructure",
  "private": true,
  "version": "1.0.0",
  "description": "BMC Intelligence Infrastructure — sovereign urban intelligence and decision infrastructure for the municipal corporations of Maharashtra. Maha AI · Urban Intelligence Infrastructure.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "server": "tsx watch --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/src/index.ts",
    "server:start": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/src/index.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/scripts/seed.ts",
    "db:import": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/scripts/import.ts",
    "db:verify": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/scripts/verify-chain.ts",
    "db:status": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/scripts/status.ts",
    "ai:models": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.server.json server/scripts/ai-models.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "serve": "node scripts/serve.mjs",
    "start": "NODE_ENV=production SERVE_STATIC=true tsx --tsconfig tsconfig.server.json server/src/index.ts",
    "start:demo": "npm run build && node scripts/serve.mjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run lint && npm run audit:layout && npm run audit:i18n && npm run build && npm run smoke && npm run smoke:copilot && npm run smoke:pages && npm run smoke:i18n && npm run verify:filters",
    "audit:layout": "node scripts/audit-layout.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "i18n:keys": "node scripts/i18n-keys.mjs",
    "i18n:missing": "node scripts/i18n-keys.mjs --missing",
    "i18n:frozen": "node scripts/i18n-frozen.mjs",
    "i18n:rendered": "node scripts/i18n-render-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:copilot": "node scripts/smoke-copilot.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "smoke:i18n": "node scripts/smoke-i18n.mjs",
    "preview:design": "npm run build && node scripts/design-preview.mjs",
    "preview:login": "npm run build && node scripts/login-preview.mjs",
    "verify:filters": "node scripts/audit-filters.mjs && node --max-old-space-size=8192 scripts/filter-runtime.mjs && node --max-old-space-size=8192 scripts/shell-filter-runtime.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.26.0",
    "mongodb": "^6.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
